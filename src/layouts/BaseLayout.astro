---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} | Lakeside Labels</title>
  <meta name="description" content={description}>

  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <meta name="theme-color" content="#1e3a5f">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:site_name" content="Lakeside Labels">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <nav>
    <a href="/" class="logo">Lakeside Labels</a>
    <a href="/#contact" class="nav-cta">Get a Quote</a>
  </nav>

  <slot />

  <footer>
    <div class="footer-content">
      <p><strong>Lakeside Labels</strong></p>
      <p>Custom labels for Chicago makers</p>
      <p class="footer-contact">hello@lakesidelabels.com</p>
    </div>
  </footer>

  <style is:global>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --color-navy: #1e3a5f;
      --color-navy-dark: #152a45;
      --color-lake: #4a90a4;
      --color-lake-light: #6bb3c9;
      --color-sand: #f5f1eb;
      --color-white: #ffffff;
      --color-text: #2c3e50;
      --color-text-muted: #64748b;
    }

    body {
      font-family: 'Inter', -apple-system, sans-serif;
      background: var(--color-white);
      color: var(--color-text);
      line-height: 1.6;
    }

    nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      padding: 1rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: var(--color-white);
      border-bottom: 1px solid rgba(0,0,0,0.08);
      z-index: 100;
    }

    .logo {
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--color-navy);
      text-decoration: none;
    }

    .nav-cta {
      padding: 0.5rem 1.25rem;
      background: var(--color-navy);
      color: var(--color-white);
      text-decoration: none;
      font-weight: 600;
      font-size: 0.875rem;
      border-radius: 6px;
      transition: background 0.2s;
    }

    .nav-cta:hover {
      background: var(--color-navy-dark);
    }

    footer {
      background: var(--color-navy);
      color: var(--color-white);
      padding: 3rem 2rem;
      text-align: center;
    }

    .footer-content p {
      margin-bottom: 0.5rem;
      opacity: 0.9;
    }

    .footer-contact {
      margin-top: 1rem;
      opacity: 0.7;
      font-size: 0.875rem;
    }

    @media (max-width: 640px) {
      nav {
        padding: 1rem 1.25rem;
      }

      .logo {
        font-size: 1rem;
      }
    }
  </style>
</body>
</html>
