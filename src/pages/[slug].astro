---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const verticals = await getCollection('verticals');
  return verticals.map((vertical) => ({
    params: { slug: vertical.id },
    props: { vertical },
  }));
}

const { vertical } = Astro.props;
const { Content } = await render(vertical);
---

<BaseLayout title={vertical.data.title} description={vertical.data.description}>
  <main>
    <section class="hero">
      <div class="hero-content">
        <p class="hero-eyebrow">Chicago Label Printing</p>
        <h1>{vertical.data.headline}</h1>
        <p class="hero-sub">{vertical.data.subheadline}</p>
        <a href="#configurator" class="btn-primary">Start Designing</a>
      </div>
    </section>

    <section class="benefits">
      <div class="benefits-grid">
        {vertical.data.benefits.map((benefit: string) => (
          <div class="benefit-item">
            <span class="benefit-check">✓</span>
            <span>{benefit}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="specs">
      <div class="specs-inner">
        <div class="spec-group">
          <h3>Materials</h3>
          <ul>
            {vertical.data.materials.map((m: string) => <li>{m}</li>)}
          </ul>
        </div>
        <div class="spec-group">
          <h3>Popular Sizes</h3>
          <ul>
            {vertical.data.sizes.map((s: string) => <li>{s}</li>)}
          </ul>
        </div>
        <div class="spec-group">
          <h3>Details</h3>
          <ul>
            <li><strong>Minimum:</strong> {vertical.data.minOrder}</li>
            <li><strong>Lead time:</strong> {vertical.data.leadTime}</li>
            <li><strong>Proofs:</strong> Free digital proofs</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="content-section">
      <div class="content-inner">
        <Content />
      </div>
    </section>

    <section class="configurator" id="configurator">
      <h2>Design Your Labels</h2>
      <p>Use our configurator to see pricing instantly.</p>
      <div class="configurator-embed">
        <iframe
          src="https://configure.2fulfill.ai/lakeside/roll-labels"
          width="100%"
          height="1000"
          frameborder="0"
          title="Label Configurator"
          loading="lazy"
        ></iframe>
      </div>
    </section>

    <section class="quote" id="quote">
      <div class="quote-inner">
        <div class="quote-text">
          <h2>Prefer to Talk?</h2>
          <p>Not ready for the configurator? Drop us a message and we'll get back to you within 24 hours.</p>
        </div>
        <div class="quote-form">
          <LeadForm vertical={vertical.id} cta="Send Message" />
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  main {
    padding-top: 60px;
  }

  .hero {
    min-height: 50vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      linear-gradient(135deg, rgba(14, 74, 111, 0.8) 0%, rgba(10, 50, 75, 0.85) 100%),
      url('https://images.unsplash.com/photo-1581373449483-37449f962b6c?w=1920&q=80') center/cover no-repeat;
    color: var(--color-white);
    padding: 4rem 2rem;
    text-align: center;
  }

  .hero-content {
    max-width: 600px;
  }

  .hero-eyebrow {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.8;
    margin-bottom: 1rem;
  }

  .hero h1 {
    font-size: clamp(2rem, 6vw, 3rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 1rem;
  }

  .hero-sub {
    font-size: 1.125rem;
    opacity: 0.9;
    margin-bottom: 2rem;
  }

  .btn-primary {
    display: inline-block;
    padding: 1rem 2rem;
    background: var(--color-lake);
    color: var(--color-white);
    text-decoration: none;
    font-weight: 600;
    border-radius: 6px;
    transition: background 0.2s;
  }

  .btn-primary:hover {
    background: var(--color-lake-light);
  }

  .benefits {
    background: var(--color-sand);
    padding: 2rem;
  }

  .benefits-grid {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem 3rem;
  }

  .benefit-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 500;
  }

  .benefit-check {
    color: var(--color-lake);
    font-weight: 700;
  }

  .specs {
    max-width: 900px;
    margin: 0 auto;
    padding: 4rem 2rem;
  }

  .specs-inner {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .spec-group h3 {
    font-size: 1rem;
    color: var(--color-navy);
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .spec-group ul {
    list-style: none;
  }

  .spec-group li {
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(0,0,0,0.06);
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  .content-section {
    background: var(--color-white);
    padding: 4rem 2rem;
  }

  .content-inner {
    max-width: 700px;
    margin: 0 auto;
  }

  .content-inner :global(h2) {
    font-size: 1.5rem;
    color: var(--color-navy);
    margin: 2rem 0 1rem;
  }

  .content-inner :global(h3) {
    font-size: 1.125rem;
    color: var(--color-navy);
    margin: 1.5rem 0 0.75rem;
  }

  .content-inner :global(p) {
    color: var(--color-text-muted);
    margin-bottom: 1rem;
    line-height: 1.7;
  }

  .configurator {
    background: var(--color-sand);
    padding: 4rem 0;
    text-align: center;
  }

  .configurator h2,
  .configurator > p {
    padding: 0 2rem;
  }

  .configurator h2 {
    font-size: 1.75rem;
    color: var(--color-navy);
    margin-bottom: 0.5rem;
  }

  .configurator > p {
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }

  .configurator-embed {
    max-width: 100%;
    width: 100%;
  }

  .configurator-placeholder {
    background: var(--color-white);
    border: 2px dashed rgba(0,0,0,0.15);
    border-radius: 12px;
    padding: 4rem 2rem;
    color: var(--color-text-muted);
  }

  .configurator-placeholder p {
    font-weight: 600;
    color: var(--color-navy);
  }

  .quote {
    background: var(--color-white);
    padding: 5rem 2rem;
  }

  .quote-inner {
    max-width: 900px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 4rem;
    align-items: start;
  }

  .quote-text h2 {
    font-size: 2rem;
    color: var(--color-navy);
    margin-bottom: 1rem;
  }

  .quote-text p {
    color: var(--color-text-muted);
    font-size: 1.0625rem;
  }

  .quote-form {
    background: var(--color-sand);
    padding: 2rem;
    border-radius: 12px;
  }

  @media (max-width: 768px) {
    .specs-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .quote-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .configurator h2,
    .configurator > p {
      padding: 0 1rem;
    }
  }
</style>
